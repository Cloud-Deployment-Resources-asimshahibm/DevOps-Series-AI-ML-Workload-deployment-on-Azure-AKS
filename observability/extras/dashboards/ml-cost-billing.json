    },
    {
     "refId": "F",
     "expr": "namespace:cost_pv_hourly:usd",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 3
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "$/hour",
       "Value #B": "$/month (run-rate)",
       "Value #C": "CPU $/h",
       "Value #D": "RAM $/h",
       "Value #E": "GPU $/h",
       "Value #F": "Storage $/h"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "$/hour",
        "desc": true
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true
   }
