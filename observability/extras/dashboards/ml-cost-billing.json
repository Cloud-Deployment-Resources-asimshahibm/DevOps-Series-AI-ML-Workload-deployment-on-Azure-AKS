   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "namespace:cost_hourly:usd",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "namespace:cost_hourly:usd * 730",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "C",
     "expr": "namespace:cost_cpu_hourly:usd",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "D",
     "expr": "namespace:cost_ram_hourly:usd",
