{
 "uid": "ml-cost-billing",
 "title": "ML Platform \u2014 Cost & Billing",
 "description": "OpenCost allocation + Azure Cost Management pointers. Budgets & anomaly alerts: Cost Management budgets / anomaly alert (Terraform).",
 "tags": [
  "ml",
  "cost",
  "finops"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "prometheus"
    },
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Run-rate & budget (OpenCost \u2014 in-cluster)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Cluster cost / hour",
   "description": "Nodes + persistent volumes + AKS control plane, priced by OpenCost (pay-as-you-go list prices).",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cluster:cost_hourly:usd",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Projected monthly",
   "description": "Current hourly run-rate x 730 h",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cluster:cost_monthly_projection:usd",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "gauge",
   "title": "Budget used (projection)",
   "description": "Projected monthly / monthly budget (charts/observability-rules values).",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cluster:cost_budget_utilisation:ratio",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1.5,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Cost in selected range",
   "description": "Integral of the hourly run-rate across the dashboard time range.",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum_over_time(cluster:cost_hourly:usd[$__range:1h])",
